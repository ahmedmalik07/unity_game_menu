/* ==========================================================================
   AETHERFALL - main menu screens
   ========================================================================== */

.screen--main {
    flex-direction: row;
    align-items: center;
    padding-left: 150px;
}

.main-column {
    justify-content: center;
    margin-top: -40px;
}

/* ----------------------------------------------------------- Top bar */

.topbar {
    position: absolute;
    left: 150px;
    right: 120px;
    top: 52px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}



.topbar__clock {
    font-size: 18px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: var(--c-muted);
}

/* ----------------------------------------------------------- Brand */

.brand {
    margin: 0 0 64px 0;
    transition-property: opacity, translate;
    transition-duration: 1.2s, 1.4s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.brand.is-pre {
    translate: 0 -18px;
}


.brand__title {
    font-size: 112px;
    letter-spacing: 10px;
    -unity-font-style: bold;
    color: #F4F7FF;
    padding: 0;
    margin: 0;
}

.brand__rule {
    width: 420px;
    height: 2px;
    margin: 4px 0 0 6px;
    -unity-background-scale-mode: stretch-to-fill;
}

/* ----------------------------------------------------------- News card */









/* ----------------------------------------------------------- Footer */

.footer {
    position: absolute;
    left: 150px;
    right: 120px;
    bottom: 56px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    transition-property: opacity, translate;
    transition-duration: 0.8s, 0.8s;
}

.footer.is-pre {
    translate: 0 12px;
}

.hints {
    flex-direction: row;
}

.footer__version {
    font-size: 13px;
    letter-spacing: 3px;
    color: rgba(205, 214, 255, 0.4);
}

/* ----------------------------------------------------------- Credits */

.panel--credits {
    width: 760px;
    height: 560px;
}

.credits {
    flex-grow: 1;
    padding-top: 20px;
}


.credits__entry {
    margin-bottom: 38px;
}

.credits__role {
    font-size: 14px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    color: var(--c-accent);
    padding: 0;
    margin: 0 0 6px 0;
}

.credits__name {
    font-size: 28px;
    padding: 0;
    margin: 0;
}

/* ----------------------------------------------------------- Loading */

.screen--loading {
    justify-content: flex-end;
    padding: 0 150px 110px 150px;
    background-color: rgba(2, 3, 10, 0.82);
}

.loading__chapter {
    font-size: 17px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    color: var(--c-accent);
    padding: 0;
    margin: 0 0 6px 4px;
}

.loading__title {
    font-size: 72px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.loading__tip {
    max-width: 920px;
    font-size: 22px;
    color: var(--c-muted);
    white-space: normal;
    padding: 0;
    margin: 16px 0 0 4px;
    transition-property: opacity, translate;
    transition-duration: 0.4s, 0.4s;
}

.loading__tip--out {
    opacity: 0;
    translate: 0 6px;
}

.loading__bar {
    height: 3px;
    margin-top: 56px;
    border-radius: 2px;
    background-color: var(--c-faint);
    overflow: hidden;
}

.loading__fill {
    height: 100%;
    width: 0;
    background-color: var(--c-accent);
}

.loading__row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 18px;
}

.loading__status-group {
    flex-direction: row;
    align-items: center;
}

.loading__spinner {
    width: 22px;
    height: 22px;
    margin-right: 14px;
}

.loading__status {
    font-size: 14px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    color: var(--c-muted);
}

.loading__percent {
    font-size: 22px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}
