<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Common.uss" />
    <Style src="MainMenu.uss" />
    <ui:Template name="SettingsPanel" src="Components/SettingsPanel.uxml" />
    <ui:Template name="ConfirmDialog" src="Components/ConfirmDialog.uxml" />

    <ui:VisualElement name="app" class="app">
        <ui:VisualElement name="background" class="layer" picking-mode="Ignore" />
        <ui:VisualElement name="vignette" class="layer vignette" picking-mode="Ignore" />

        <!-- Main -->
        <ui:VisualElement name="screen-main" class="screen screen--main">
            <ui:VisualElement class="topbar" picking-mode="Ignore">
                <ui:Label name="clock" text="00:00" class="topbar__clock" />
            </ui:VisualElement>

            <ui:VisualElement class="main-column">
                <ui:VisualElement name="brand" class="brand is-pre" picking-mode="Ignore">
                    <ui:Label text="AETHERFALL" class="brand__title" />
                    <ui:VisualElement name="brand-rule" class="brand__rule" />
                </ui:VisualElement>

                <ui:VisualElement name="main-buttons" class="menu-list">
                    <ui:Button name="btn-continue" class="menu-button is-pre">
                        <ui:VisualElement class="menu-button__glow" picking-mode="Ignore" />
                        <ui:VisualElement class="menu-button__bar" picking-mode="Ignore" />
                        <ui:Label text="CONTINUE" class="menu-button__label" picking-mode="Ignore" />
                        <ui:Label name="continue-meta" text="" class="menu-button__meta" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="btn-new-game" class="menu-button is-pre">
                        <ui:VisualElement class="menu-button__glow" picking-mode="Ignore" />
                        <ui:VisualElement class="menu-button__bar" picking-mode="Ignore" />
                        <ui:Label text="NEW GAME" class="menu-button__label" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="btn-settings" class="menu-button is-pre">
                        <ui:VisualElement class="menu-button__glow" picking-mode="Ignore" />
                        <ui:VisualElement class="menu-button__bar" picking-mode="Ignore" />
                        <ui:Label text="SETTINGS" class="menu-button__label" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="btn-credits" class="menu-button is-pre">
                        <ui:VisualElement class="menu-button__glow" picking-mode="Ignore" />
                        <ui:VisualElement class="menu-button__bar" picking-mode="Ignore" />
                        <ui:Label text="CREDITS" class="menu-button__label" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="btn-quit" class="menu-button is-pre">
                        <ui:VisualElement class="menu-button__glow" picking-mode="Ignore" />
                        <ui:VisualElement class="menu-button__bar" picking-mode="Ignore" />
                        <ui:Label text="QUIT" class="menu-button__label" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="footer" class="footer is-pre" picking-mode="Ignore">
                <ui:VisualElement class="hints">
                    <ui:VisualElement class="hint">
                        <ui:Label text="W / S" class="key" />
                        <ui:Label text="NAVIGATE" class="hint__text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hint">
                        <ui:Label text="ENTER" class="key" />
                        <ui:Label text="SELECT" class="hint__text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hint">
                        <ui:Label text="ESC" class="key" />
                        <ui:Label text="BACK" class="hint__text" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="version" text="v1.0.0" class="footer__version" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Settings -->
        <ui:Instance template="SettingsPanel" name="screen-settings" class="screen screen--center" />

        <!-- Credits -->
        <ui:VisualElement name="screen-credits" class="screen screen--center">
            <ui:VisualElement class="panel panel--credits">
                <ui:VisualElement class="panel__header">
                    <ui:Label text="CREDITS" class="panel__title" />
                </ui:VisualElement>
                <ui:VisualElement class="credits">
                    <ui:VisualElement class="credits__entry">
                        <ui:Label text="MADE BY" class="credits__role" />
                        <ui:Label text="ahmedmalik07" class="credits__name" />
                    </ui:VisualElement>
                    <ui:VisualElement class="credits__entry">
                        <ui:Label text="ENGINE" class="credits__role" />
                        <ui:Label text="Unity 6" class="credits__name" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="panel__footer">
                    <ui:Label text="Thanks for playing!" class="setting-description" />
                    <ui:VisualElement class="panel__actions">
                        <ui:Button name="btn-credits-back" text="BACK" class="pill-button pill-button--primary" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Loading -->
        <ui:VisualElement name="screen-loading" class="screen screen--loading" picking-mode="Ignore">
            <ui:VisualElement class="loading" picking-mode="Ignore">
                <ui:Label name="loading-chapter" text="CHAPTER 1" class="loading__chapter" />
                <ui:Label name="loading-title" text="The Rift" class="loading__title" />
                <ui:Label name="loading-tip" text="" class="loading__tip" />
                <ui:VisualElement class="loading__bar">
                    <ui:VisualElement name="loading-fill" class="loading__fill" />
                </ui:VisualElement>
                <ui:VisualElement class="loading__row">
                    <ui:VisualElement class="loading__status-group">
                        <ui:VisualElement name="loading-spinner" class="loading__spinner" />
                        <ui:Label name="loading-status" text="LOADING" class="loading__status" />
                    </ui:VisualElement>
                    <ui:Label name="loading-percent" text="0%" class="loading__percent" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Instance template="ConfirmDialog" name="dialog" class="layer modal" />
        <ui:VisualElement name="fader" class="layer fader fader--on" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
