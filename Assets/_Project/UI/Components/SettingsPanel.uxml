<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Common.uss" />
    <ui:VisualElement class="panel panel--settings">
        <ui:VisualElement class="panel__header">
            <ui:Label text="SETTINGS" class="panel__title" />
        </ui:VisualElement>
        <ui:VisualElement class="tabs">
            <ui:Label text="Q" class="key key--tab" />
            <ui:Button name="tab-graphics" text="GRAPHICS" class="tab" />
            <ui:Button name="tab-audio" text="AUDIO" class="tab" />
            <ui:Button name="tab-gameplay" text="GAMEPLAY" class="tab" />
            <ui:Label text="E" class="key key--tab" />
        </ui:VisualElement>
        <ui:VisualElement class="panel__body">
            <ui:VisualElement name="page-graphics" class="settings-page" />
            <ui:VisualElement name="page-audio" class="settings-page" />
            <ui:VisualElement name="page-gameplay" class="settings-page" />
        </ui:VisualElement>
        <ui:VisualElement class="panel__footer">
            <ui:Label name="setting-description" text="" class="setting-description" />
            <ui:VisualElement class="panel__actions">
                <ui:Button name="btn-settings-reset" text="RESET DEFAULTS" class="pill-button" />
                <ui:Button name="btn-settings-back" text="DONE" class="pill-button pill-button--primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
